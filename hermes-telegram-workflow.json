{
  "name": "Hermes Agent - Telegram Direto (Grátis)",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "telegram-trigger",
      "name": "1. Receber Mensagem no Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://focoemdados.com.br/api/chat-hermes",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": \"{{ $json.message.text }}\",\n  \"phone\": \"{{ $json.message.from.id }}\",\n  \"source\": \"Telegram\"\n}",
        "options": {}
      },
      "id": "hermes-api",
      "name": "2. Cérebro Hermes (GCP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $('1. Receber Mensagem no Telegram').item.json.message.chat.id }}",
        "text": "={{ $json.reply }}",
        "additionalFields": {}
      },
      "id": "telegram-reply",
      "name": "3. Enviar Resposta ao Cliente",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "1. Receber Mensagem no Telegram": {
      "main": [
        [
          {
            "node": "2. Cérebro Hermes (GCP)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Cérebro Hermes (GCP)": {
      "main": [
        [
          {
            "node": "3. Enviar Resposta ao Cliente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
