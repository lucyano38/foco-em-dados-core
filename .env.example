# ======================
# FOCO EM DADOS — Exemplo de variáveis de ambiente
# Copie para .env (backend local) e configure no painel da Vercel (front-end).
# Valores reais NUNCA devem ser commitados.
# ======================

# ---------- Frontend (VITE_* — inlined at build time, visible in browser) ----------
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-pub"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
VITE_APP_URL="https://focoemdados.com.br"

# ---------- Backend (server.ts runtime) ----------
PORT="8080"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
TELEGRAM_BOT_TOKEN="..."
TELEGRAM_ADMIN_CHAT_ID="..."
CHATBOT_API_URL="https://chatbot-v2-240342026700.us-central1.run.app"
ADMIN_PASSWORD="foco2026"

# ---------- IA: OpenRouter como provider padrão, Gemini habilitado como fallback ----------
# O Gemini (GCP API) permanece HABILITADO e é usado como fallback quando o
# OpenRouter/9router falhar ou estiver indisponível.
DEFAULT_AI_PROVIDER="openrouter"
MAX_COST_PER_MONTH=0.00
PREFER_FREE_MODELS=true
FREE_MODEL="gc/gemini-2.5-flash"
GEMINI_API_KEY="sua-chave-gemini"
OPENROUTER_API_KEY="sk-or-v1-..."
9ROUTER_BASE_URL="http://localhost:20128"

# ---------- Segurança: trava diária de prospecção ----------
DAILY_PROSPECTION_LIMIT="5"
RESEND_API_KEY="re_..."      # opcional — envio de e-mail (Resend), limitado a 5/dia

# ---------- WAHA Plus (WhatsApp HTTP API) e n8n ----------
# URL da instância WAHA Plus. Envio de mensagens: POST {WAHA_API_URL}/api/sendText
WAHA_API_URL="https://waha.exemplo.com"
WAHA_API_KEY="sua-chave"     # header X-Api-Key (obrigatório no Plus)
WAHA_SESSION="default"
WAHA_WEBHOOK_TOKEN="token-compartilhado-com-o-waha/n8n"  # valida POST /api/waha/webhook

# ---------- Busca de leads: API externa opcional (Google Maps etc.) ----------
# Se não configurada, o endpoint /api/prospection/search usa o mock inteligente.
# PROSPECTION_API_URL="https://api.exemplo.com/buscar-leads"
